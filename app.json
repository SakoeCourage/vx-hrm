{
  "expo": {
    "name": "vx-hrm",
    "slug": "vx-hrm",
    "version": "1.0.0",
    "newArchEnabled": true,
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vxhrm",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.variablexsolutions.vxhrm"
    },
    "android": {
      "package": "com.variablexsolutions.vxhrm",
      "adaptiveIcon": {
        "backgroundColor": "#e4f6fa",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#087d96",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 260
        }
      ],
      "expo-font",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow VX HRM to select a passport picture from your photos.",
          "cameraPermission": "Allow VX HRM to capture your passport picture."
        }
      ],
      "expo-asset",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.5"
          },
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7ce225b5-bbd6-4fc4-9bc1-860042c90b7e"
      }
    },
    "owner": "sakoecourage"
  }
}
